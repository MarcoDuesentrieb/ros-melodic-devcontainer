<?xml version="1.0"?>
<robot name="jetbot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_sep" value="0.1648"/>
  <xacro:property name="ball_radius" value="0.016" />   
  <xacro:property name="ball_mass"   value="0.025" />    


  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- *.dae -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://jetbot_description/mesh/base.dae" scale="1 1 1"/></geometry>
    </visual>

    <!-- Kollision -->
    <collision>
    <origin xyz="0 0 0.036" rpy="0 0 0"/>
      <geometry><cylinder radius="0.105" length="0.162"/></geometry>
    </collision>

    <inertial>
    <mass value="0.7"/> <!-- z.B. 0.7 kg Base + 0.05+0.05 Wheels + 0.02+0.02 Sensors = 0.84 kg -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia
      ixx="3.9e-3"
      iyy="3.9e-3"
      izz="4.4e-3"
      ixy="0" ixz="0" iyz="0"/>
  </inertial>
  </link>

  <!-- Wheels, joints needed for diff-drive -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><mesh filename="package://jetbot_description/mesh/wheel.dae" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.033" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.0824 -0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.570 0 0"/>
      <geometry><mesh filename="package://jetbot_description/mesh/wheel.dae" scale="1 1 1"/></geometry>
    </visual>
      <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.033" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.0824 -0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Castor wheels -->
  <link name="front_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${ball_radius}"/>
      </geometry>
    </collision>

    <inertial>
        <mass value="${ball_mass}" />
        <origin xyz="0 0 0" />
        <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_wheel"/>
    <origin xyz="-0.072 0 -0.032" rpy="0 0 0"/> 
  </joint> 

  <link name="rear_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${ball_radius}"/>
      </geometry>
    </collision>
    <inertial>
        <mass value="${ball_mass}" />
        <origin xyz="0 0 0" />
        <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rear_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_wheel"/>
    <!-- The z-coordinate is slightly offset compared to the front_wheel to avoid static over-constraint, 
         which would otherwise cause unwanted side effects in the physics engine (e.g., rotation around the 
         z-axis even when angular.z = 0 in cmd_vel -->
    <origin xyz="0.072 0 -0.0319" rpy="0 0 0"/> 
  </joint> 


    <!-- Camera -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0.0040" rpy="3.14159 3.14159 1.5707"/>
      <geometry><mesh filename="package://jetbot_description/mesh/cam.dae" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.012 0 -0.0005" rpy="0 1.5707 0"/>
      <geometry><cylinder radius="0.008" length="0.012"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="5e-5" iyy="5e-5" izz="5e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0955 0 0.0470" rpy="0 0 0"/>
  </joint>

  <gazebo reference="front_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="rear_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <material>Gazebo/Orange</material>
  </gazebo>

   <gazebo reference="left_wheel">
        <mu1 value="5.0"/>
        <mu2 value="5.0"/>
  </gazebo>
  <gazebo reference="right_wheel">
        <mu1 value="5.0"/>
        <mu2 value="5.0"/>
  </gazebo>


  <!-- LiDAR -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://jetbot_description/mesh/lidar.dae" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.01" length="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="5e-5" iyy="5e-5" izz="5e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Plugins -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <updateRate>100</updateRate>
      <wheelTorque>5</wheelTorque>
      <wheelAcceleration>6</wheelAcceleration>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometrySource>world</odometrySource> <!-- world: ground truth provided by Gazebo -->
      <publishOdomTF>true</publishOdomTF>
      <publishWheelJointState>true</publishWheelJointState>
      <publishWheelTF>true</publishWheelTF>
      <publishTf>true</publishTf>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <rosDebugLevel>na</rosDebugLevel>
      <wheelSeparation>${wheel_sep}</wheelSeparation>
      <wheelDiameter>${2*wheel_radius}</wheelDiameter>
    </plugin>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor name="RPLidar A1" type="ray">
      <visualize>false</visualize>
      <always_on>true</always_on>
      <update_rate>12</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="IMX219-160 Camera" type="camera">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera>
        <!-- Diagonal FOV: 160 deg on 1/4 inch sensor-->
        <horizontal_fov>1.047</horizontal_fov> 
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.017</near>
          <far>20</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.002</stddev>
        </noise>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>20</updateRate>
        <cameraName>csi_cam_0</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_link</frameName>
        <hackBaseline>0.0</hackBaseline>
        <!-- Distortion coefficients for 640 x 480 -->
        <distortionK1>-0.3099359644894822</distortionK1>
        <distortionK2>0.08151662693197913</distortionK2>
        <distortionK3>0.0006660916041993709</distortionK3>
        <distortionT1>0.001461474111496217</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>
</robot>